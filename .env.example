# Copy to .env in the repository root on the office desktop.
# Do NOT commit .env. This file contains public-address placeholders only.
# Fee: 500 basis points = 5% of surplus after loan premium, before gas.
ARBITRARY_MERCHANT_FEE_BPS=500

# Customer profit destination (USDC for baseline routes).
ARBITRARY_PROFIT_WALLET=
# Dedicated signing/operator address: send native gas funds here on the chosen chain.
ARBITRARY_GAS_WALLET=
# Merchant's USDC revenue destination.
ARBITRARY_MERCHANT_WALLET=
# Administrative owner: may be an existing public wallet; not a revenue destination.
ARBITRARY_OWNER_WALLET=

# RPC credentials remain only on this computer. Fill only the chains you intend to use.
RPC_1=
RPC_42161=
RPC_8453=
RPC_10=
RPC_137=
RPC_43114=

# Fill after deployment. A different executor contract is needed per chain.
ARBITRARY_EXECUTOR_1=
ARBITRARY_EXECUTOR_42161=
ARBITRARY_EXECUTOR_8453=
ARBITRARY_EXECUTOR_10=
ARBITRARY_EXECUTOR_137=
ARBITRARY_EXECUTOR_43114=

# Optional chain-specific wallet override, all still in this ONE file:
# ARBITRARY_PROFIT_WALLET_42161=
# ARBITRARY_GAS_WALLET_42161=
# ARBITRARY_MERCHANT_WALLET_42161=
# ARBITRARY_OWNER_WALLET_42161=
# ARBITRARY_MERCHANT_FEE_BPS_42161=500

# NO private keys, seed phrases or keystore passwords here.
# Unlock the encrypted operator keystore locally at the CLI prompt.
# .env cannot enable live trading or automatically enable networks.
